# Direct dependencies maintained by hand.
# Run `pip-compile requirements.in -o requirements.txt` to regenerate the lockfile.
# Run `pip install -r requirements.txt` to install the default runnable stack.
#
# NOTE: apache-airflow is intentionally excluded because its constraints are not
# compatible with this pip-compile workflow. Install Airflow separately when
# needed:
#   pip install apache-airflow --constraint <airflow-constraints-url>

# Data storage
duckdb          # Columnar warehouse (Snowflake/BigQuery analogue; zero ops)
pyarrow         # Parquet read/write and efficient pandas interop

# Configuration
python-dotenv   # Loads .env into os.environ; keeps secrets out of source code

# Data ingestion
requests        # HTTP client for official datasets and article fetches
trafilatura     # Battle-tested article text extractor for French news sites
beautifulsoup4  # HTML parser for document-export articles (explicit dep; also pulled by trafilatura)
pdfminer-six    # PDF text extraction handling modern CIDFont/ToUnicode encodings (Europresse)
beautifulsoup4  # Explicit HTML parser dependency used by corpus.py
openpyxl        # pandas.read_excel() support for .xlsx source files
rapidfuzz       # Fast fuzzy string matching for incumbent matching
pyyaml          # Structured config files and reusable local manifests

# Data analysis
pandas          # DataFrame manipulation at silver/gold boundaries
numpy           # Numerical helpers for metrics and regression prep
scipy           # Statistical tests
statsmodels     # Poisson regression audit layer

# Dashboard
streamlit       # Python-native dashboard

# Visualization
matplotlib      # Base plotting library
seaborn         # Statistical visualization on top of matplotlib

# Dev / quality tools
black==24.10.0  # Stable formatter version for the Windows CI/dev toolchain
ruff            # Fast linter
pytest          # Test runner
pytest-cov      # Coverage plugin backing the documented test-coverage command
pip-tools       # Provides pip-compile for lockfile generation

# Optional future stack
# Transformer NLP models and dbt stay out of the default environment until the
# corresponding production modules are committed to this repository.
